# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# OS
.DS_Store

# Notebooks / scratch
.ipynb_checkpoints/

# Generated demo outputs (keep the curated ones in assets/)
examples/*.png
examples/*.gif

# MOT dataset caches (regenerate with data/cache/precompute.py). The committed
# frozen splits under data/splits/ are intentionally NOT ignored.
data/cache/*.npz
data/cache/**/*.npz

# Generated experiment artifacts (regenerate via experiments/run_matrix.py
# and `make reproduce`). Configs under experiments/configs/ ARE committed.
*.parquet
results*.parquet
experiments/reports/
docs/results_*.md
# Raw datasets should never be committed (root-anchored so they do NOT match
# the src/visiontrack/datasets/ code package).
/MOT17/
/datasets/
/data/MOT17/

# Pretrained re-ID model weights (OSNet ONNX etc.) — downloaded on demand, not
# committed (own dataset licenses; keep the repo weight-free like the imagery).
models/
*.onnx

# mkdocs build output
/site/

# Vercel docs build output
/vercel_build/
node_modules/
.pydeps/
