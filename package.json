{
  "name": "visiontrack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VisionTrack product site and documentation build.",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build:docs": "python3 -m pip install --quiet --disable-pip-version-check --target .pydeps 'mkdocs-material>=9.5' && PYTHONPATH=.pydeps python3 -m mkdocs build -d vercel_build/docs",
    "build": "npm run build:app && npm run build:docs",
    "test:decision-contract": "node scripts/test-decision-contract.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2",
    "vite": "^6.1.0"
  }
}
